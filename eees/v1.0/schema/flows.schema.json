{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "standardVersion": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$"
    },
    "source": {
      "type": "string"
    },
    "requiredFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "consumer": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "failing",
              "unknown"
            ]
          },
          "measuredAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "producer",
          "consumer",
          "critical",
          "status",
          "measuredAt",
          "evidence"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "standardVersion",
    "updated",
    "requiredFields",
    "flows"
  ]
}
